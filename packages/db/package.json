{
	"name": "@vitruvius/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"test": "vitest run",
		"db:start": "supabase start",
		"db:reset": "supabase db reset",
		"db:stop": "supabase stop"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1075.0",
		"@aws-sdk/s3-request-presigner": "^3.1075.0",
		"@supabase/supabase-js": "^2.45.0",
		"@vitruvius/core": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "24.7.0",
		"@vitruvius/ai": "workspace:*",
		"@vitruvius/export": "workspace:*",
		"dotenv": "^16.4.0",
		"typescript": "6.0.3",
		"vitest": "^3.0.0"
	}
}
