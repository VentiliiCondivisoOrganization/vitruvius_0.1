{
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"plugins": ["prettier-plugin-organize-imports"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": {
				"plugins": ["prettier-plugin-organize-imports", "prettier-plugin-svelte"],
				"parser": "svelte"
			}
		},
		{
			"files": "*.sql",
			"options": {
				"plugins": ["prettier-plugin-sql"],
				"language": "postgresql",
				"keywordCase": "upper"
			}
		}
	]
}
