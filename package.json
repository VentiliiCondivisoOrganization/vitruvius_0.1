{
	"name": "vitruvius",
	"version": "0.2.9",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.12.1",
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format": "prettier --write --cache ${CI:+--cache-strategy content} .",
		"format:check": "prettier --check --cache ${CI:+--cache-strategy content} .",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "24.7.0",
		"eslint": "10.5.0",
		"globals": "16.4.0",
		"prettier": "3.8.4",
		"prettier-plugin-organize-imports": "4.3.0",
		"prettier-plugin-sql": "0.20.0",
		"prettier-plugin-svelte": "4.1.1",
		"supabase": "^2.0.0",
		"turbo": "2.9.18",
		"typescript": "6.0.3",
		"typescript-eslint": "8.61.1"
	}
}
