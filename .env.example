# Supabase
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (runtime AI) — used by the engine via packages/ai; Segmenter falls back to heuristics without a key
GEMINI_API_KEY=

# Optional: override the Gemini model for segmentation (default gemini-2.0-flash)
# GEMINI_SEGMENT_MODEL=gemini-2.0-flash

# Optional: override the Gemini image model for the Illustrator (spec 14); without a key the
# Illustrator falls back to reusing the keyframe as a placeholder illustration
# GEMINI_ILLUSTRATE_MODEL=gemini-2.0-flash-preview-image-generation

# Engine
ENGINE_POLL_INTERVAL_MS=2000
