{
	"name": "@vitruvius/export",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"default": "./dist/index.js"
		},
		"./html": {
			"types": "./src/html.ts",
			"development": "./src/html.ts",
			"default": "./dist/html.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "eslint src",
		"test": "vitest run"
	},
	"dependencies": {
		"@vitruvius/core": "workspace:*",
		"playwright-core": "^1.49.0"
	},
	"devDependencies": {
		"typescript": "6.0.3",
		"vitest": "^3.0.0"
	}
}
